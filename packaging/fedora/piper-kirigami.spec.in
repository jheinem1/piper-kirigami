# Generated by packaging/prepare-source.py. Edit this template, not the output.
Name:           piper-kirigami
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Experimental Qt/Kirigami frontend for ratbagd
License:        GPL-2.0-or-later AND CC-BY-SA-4.0
URL:            https://github.com/jheinem1/piper-kirigami
Source0:        %{name}-%{version}.tar.gz
BuildArch:      noarch

BuildRequires:  meson >= 0.61
BuildRequires:  ninja-build
BuildRequires:  python3-devel
BuildRequires:  desktop-file-utils
BuildRequires:  python3-pyside6 >= 6.8
BuildRequires:  python3-dbus-next >= 0.2.3
BuildRequires:  python3-pytest
BuildRequires:  python3-pytest-subtests
BuildRequires:  dbus-daemon
BuildRequires:  xorg-x11-server-Xvfb
BuildRequires:  xorg-x11-xauth
BuildRequires:  qt6-qtdeclarative
BuildRequires:  qt6-qtsvg
BuildRequires:  kf6-kirigami
BuildRequires:  kf6-qqc2-desktop-style
BuildRequires:  plasma-breeze-qt6
BuildRequires:  plasma-breeze-common
BuildRequires:  breeze-icon-theme
BuildRequires:  google-noto-sans-fonts

# Use the distribution's single, ABI-compatible Qt/PySide/KDE package set.
# Do not vendor PyPI Qt wheels into this RPM.
Requires:       python3 >= 3.10
Requires:       python3-pyside6 >= 6.8
Requires:       python3-shiboken6
Requires:       python3-dbus-next >= 0.2.3
Requires:       qt6-qtdeclarative
Requires:       qt6-qtsvg
Requires:       qt6-qtwayland
Requires:       kf6-kirigami
Requires:       kf6-qqc2-desktop-style
Requires:       plasma-breeze-qt6
Requires:       plasma-breeze-common
Requires:       breeze-icon-theme
Requires:       google-noto-sans-fonts
Requires:       libratbag-ratbagd >= 0.18

%description
A Python/QML Qt 6 and KDE Kirigami prototype for configuring gaming mice through
ratbagd. Installs a separate piper-kirigami command and desktop entry alongside
GTK Piper. The application does not include Qt libraries or a ratbagd service.
This snapshot is for integration testing, not a stable upstream Piper release.

%prep
%autosetup -n %{name}-%{version}

%build
export SOURCE_DATE_EPOCH=@SOURCE_DATE_EPOCH@
meson setup _build qt-build --prefix=%{_prefix} --bindir=%{_bindir} \
    --datadir=%{_datadir} --libdir=%{_libdir} --buildtype=plain
meson compile -C _build

%install
export SOURCE_DATE_EPOCH=@SOURCE_DATE_EPOCH@
DESTDIR=%{buildroot} meson install -C _build --no-rebuild

%check
export QT_QPA_PLATFORM=xcb
export QT_QUICK_BACKEND=software
export PYTHONDONTWRITEBYTECODE=1
export XDG_RUNTIME_DIR="$(mktemp -d)"
chmod 700 "$XDG_RUNTIME_DIR"
trap 'rm -rf "$XDG_RUNTIME_DIR"' EXIT
desktop-file-validate %{buildroot}%{_datadir}/applications/org.freedesktop.Piper.Kirigami.desktop
# Test the active frontend, model, private D-Bus protocol, and all SVG artwork.
# The native UI suite starts subprocesses, avoiding QApplication clashes.
xvfb-run -a -s "-screen 0 1600x1100x24" %{__python3} -m pytest -q tests/qt/test_backend.py tests/test_qt_diagrams.py tests/qt/test_kde_ui.py tests/qt/test_handbook.py tests/qt/test_desktop_style.py
xvfb-run -a -s "-screen 0 1600x1100x24" %{__python3} tools/verify-kde-settings.py --skip-captures --output "$XDG_RUNTIME_DIR/settings-qa"

%files
%license COPYING THIRD_PARTY_NOTICES.md
%doc README.md PACKAGING.md
%{_bindir}/piper-kirigami
%{_datadir}/piper-kirigami/
%{_datadir}/applications/org.freedesktop.Piper.Kirigami.desktop
%{_datadir}/icons/hicolor/scalable/apps/org.freedesktop.Piper.Kirigami.svg

%changelog
* @CHANGELOG_DATE@ Piper Kirigami contributors - @VERSION@-@RELEASE@
- Experimental snapshot of commit @COMMIT@.
